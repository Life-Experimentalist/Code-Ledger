; Project-level npm configuration for CodeLedger
; Use the official npm registry
registry=https://registry.npmjs.org/

; Keep package-lock.json enabled to ensure reproducible installs
package-lock=true

; Install exact versions by default to avoid accidental minor/patch upgrades
save-exact=true

; Ensure scripts find the node binary when called from PATH
scripts-prepend-node-path=true

; Prefer offline cache if present (useful in CI with npm cache)
cache=~/.npm
