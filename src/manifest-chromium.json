{
    "manifest_version": 3,
    "name": "CodeLedger",
    "version": "1.4.4",
    "description": "Your DSA journey, committed. Track and commit all your solved DSA problems to GitHub automatically.",
    "author": "VKrishna04",
    "homepage_url": "https://codeledger.vkrishna04.me",
    "icons": {
        "16": "assets/images/icon-16.png",
        "32": "assets/images/icon-32.png",
        "48": "assets/images/icon-48.png",
        "128": "assets/images/icon-128.png"
    },
    "permissions": [
        "storage",
        "alarms",
        "sidePanel"
    ],
    "host_permissions": [
        "*://*.leetcode.com/*",
        "*://*.geeksforgeeks.org/*",
        "*://*.codeforces.com/*",
        "https://api.github.com/*",
        "https://api.gitlab.com/*",
        "https://api.openai.com/*",
        "https://api.anthropic.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://api.deepseek.com/*",
        "http://localhost:11434/*"
    ],
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.leetcode.com/*",
                "*://*.geeksforgeeks.org/*",
                "*://*.codeforces.com/*"
            ],
            "js": [
                "content/handler-loader.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        },
        {
            "matches": [
                "*://codeledger.vkrishna04.me/*"
            ],
            "js": [
                "content/presence-marker.js"
            ],
            "run_at": "document_end",
            "all_frames": false
        }
    ],
    "action": {
        "default_title": "CodeLedger",
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "assets/images/icon-16.png",
            "32": "assets/images/icon-32.png",
            "48": "assets/images/icon-48.png"
        }
    },
    "side_panel": {
        "default_path": "library/library.html"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "handlers/platforms/leetcode/*",
                "handlers/platforms/geeksforgeeks/*",
                "handlers/platforms/codeforces/*",
                "handlers/_base/*",
                "handlers/ai/*",
                "handlers/git/*",
                "handlers/init.js",
                "core/*",
                "lib/*",
                "vendor/*",
                "data/*",
                "content/*",
                "ui/floating-ai.js",
                "ui/floating-timer.js",
                "ui/components/AIMarkdownRenderer.js"
            ],
            "matches": [
                "*://*.leetcode.com/*",
                "*://*.geeksforgeeks.org/*",
                "*://*.codeforces.com/*"
            ]
        },
        {
            "resources": [
                "content/presence-marker.js"
            ],
            "matches": [
                "*://codeledger.vkrishna04.me/*"
            ]
        }
    ]
}
