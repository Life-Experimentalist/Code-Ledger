# Example Wrangler configuration for CodeLedger Worker
# Copy this to `wrangler.toml` and replace placeholders with your values.

name = "codeledger-worker"
main = "src/index.js"
compatibility_date = "2026-04-24"

# Your Cloudflare Account ID (paste the 32-char id here)
account_id = "<YOUR_ACCOUNT_ID>"

# No [vars] block. Every value the Worker reads is a secret and belongs in
# `wrangler secret put`, never in this file:
#
#   CODELEDGER_OAUTH_CLIENT_ID       required — classic OAuth App client id (Ov23li…)
#   CODELEDGER_OAUTH_CLIENT_SECRET   required — that app's client secret
#   SESSION_SECRET                   required — 32 random bytes; signs the OAuth state
#                                    cookie. Sign-in returns 500 until it is set.
#   CANONICAL_UPLOAD_TOKEN           optional — guards POST /api/admin/canonical
#   CODELEDGER_GH_APP_WEBHOOK_SECRET optional — HMAC for POST /api/webhook/github

[[kv_namespaces]]
binding = "CANONICAL_MAP"
# The KV namespace id looks like: abc123def456...
id = "<CANONICAL_KV_NAMESPACE_ID>"

# The landing page, /compare and the rest of worker/public. This must be
# [assets] with binding = "ASSETS" — src/index.js serves static files through
# `c.env.ASSETS.fetch()`, and the older `[site] bucket` form binds
# __STATIC_CONTENT instead, which leaves every page 404.
[assets]
directory = "./public"
binding = "ASSETS"

# Route at TOP LEVEL, not under [env.production]: Wrangler named environments do
# not inherit kv_namespaces or [assets], so `deploy --env production` would ship
# a worker with no CANONICAL_MAP and no static pages — while the actual deploy
# path (`npm run deploy:worker` → plain `wrangler deploy`) ignored the stanza
# entirely. One top-level config keeps a single deploy path fully bound.
routes = [{ pattern = "codeledger.vkrishna04.me/*", zone_id = "<YOUR_ZONE_ID>" }]

# Notes:
# - Never commit private keys or secrets into git. Use `npx wrangler secret put <NAME>`
#   to add secrets to Cloudflare and reference them in the Worker at runtime via env.
# - This example file is safe to commit; do not copy real credentials into the repo.
